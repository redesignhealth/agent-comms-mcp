# agent-comms-mcp local development configuration.
# Copy to .env (gitignored) and fill in real values — never commit secrets.
# This file exists for local dev only.

# --- Required (the service fails fast at startup if any is missing) ---

# Okta OIDC for interactive (human) callers
OKTA_ISSUER_URL=https://<your-okta-domain>/oauth2/default
OKTA_CLIENT_ID=<okta-app-client-id>
OKTA_CLIENT_SECRET=<okta-app-client-secret>

# Signing secret for FastMCP's internal JWTs
MCP_JWT_SECRET=<generate-a-long-random-string>

# Shared HS256 secret for agent JWT verification. Required iff
# AGENT_TOKEN_VERIFIERS (below) includes the default agent_jwt_hs256
# verifier -- not required if you fully replace it with your own.
AGENT_JWT_SECRET=<shared-hs256-secret>

# --- Optional (documented defaults) ---

# Comma-separated, ordered list of agent-token verifiers: a name from
# auth.TOKEN_VERIFIERS, or a "pkg.module:factory" import path to plug in
# your own TokenVerifier without forking this repo (see DESIGN.md's
# "Configuration: pluggable agent-token verification" section). Default:
# agent_jwt_hs256 (the built-in HS256 JWTVerifier above). Coexistence
# (agent_jwt_hs256,pkg.module:factory) and full replacement (a lone import
# path) are both supported; an empty value fails startup.
#AGENT_TOKEN_VERIFIERS=agent_jwt_hs256

# Public URL of this MCP server (default: http://localhost:8080)
#
# NOTE: docker-compose.yml parameterizes BASE_URL off MCP_PORT automatically
# (its `environment:` block sets BASE_URL: http://localhost:${MCP_PORT:-8080}),
# so the two stay in sync there. That coupling does NOT apply if you run this
# service directly (e.g. `uv run main.py`, not via `docker compose up`): if
# you change MCP_PORT in that case, you must also update BASE_URL to match,
# or the OAuth redirect URI will be built against the wrong port.
#BASE_URL=http://localhost:8080

# Persistent OAuth token storage (default: /data/fastmcp-tokens)
#MCP_TOKEN_STORAGE_PATH=/data/fastmcp-tokens

# Bind host/port (defaults: 127.0.0.1 / 8080; docker-compose sets MCP_HOST=0.0.0.0)
# See the BASE_URL note above: MCP_PORT and BASE_URL must be kept in sync
# manually when not running via docker compose.
#MCP_HOST=127.0.0.1
#MCP_PORT=8080

# Postgres for the comms domain (agents/conversations/participants/
# messages/audit_log — DESIGN.md §5). Provisioned in docker-compose, which
# maps the container's Postgres to HOST port 55432 (not 5432) to avoid
# colliding with a native Postgres many dev machines already run on 5432 —
# see README.md's "Local development" section. Required once the service
# actually opens a DB session; run `uv run alembic upgrade head` after
# setting this to create the schema.
#DATABASE_URL=postgresql://postgres:postgres@localhost:55432/agent_comms

#LOG_LEVEL=INFO
